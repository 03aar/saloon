# Azure Cosmos DB
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key
COSMOS_DATABASE=bloop

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Optional: real email provider integration point (unset = verification/reset
# links are only logged to the console, not actually sent). See
# src/services/email.ts. Example if wiring up Resend/SendGrid later:
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=no-reply@bloop.app
